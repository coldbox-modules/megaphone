{
    "name": "megaphone-boxlang-cfml",
    "app": {
        "cfengine": "boxlang@1",
        "serverHomeDirectory": ".tmp/engines/boxlang-cfml"
    },
    "jvm": {
        "javaVersion": "openjdk21_jdk",
        "heapSize": 1024
    },
    "web": {
        "http": {
            "port": 51515
        }
    },
    "openBrowser": false,
    "cfconfig": {
        "file": ".cfconfig.json"
    },
    "env": {
        "MEGAPHONE_BOXLANG_MODE": "cfml"
    },
    "scripts": {
        "onServerInitialInstall": "install bx-compat-cfml,bx-mysql,bx-mail,bx-esapi --noSave"
    }
}
